{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@/components/remotion/*": ["./registry/default/primitives/*"],
      "@/lib/remotion/*": ["./registry/default/lib/*"]
    }
  },
  "include": ["registry/**/*.ts", "registry/**/*.tsx"]
}
