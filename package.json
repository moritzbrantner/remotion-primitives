{
  "name": "@moritzbrantner/remotion-primitives",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build:registry": "bunx shadcn@4.18.0 build",
    "check-types": "tsc --noEmit",
    "test:unit": "vitest run registry/default/lib/subtitle-formats.test.ts",
    "verify:registry": "bunx shadcn@4.18.0 registry validate ./registry.json && bun run build:registry --output .cache/registry-check",
    "verify": "bun run check-types && bun run test:unit && bun run verify:registry"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@remotion/captions": "^4.0.470",
    "@types/react": "^19.2.15",
    "react": "^19.2.6",
    "remotion": "^4.0.470",
    "typescript": "^6.0.2",
    "vitest": "^4.1.8"
  }
}
