{
  "name": "@moritzbrantner/remotion-primitives",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build:registry": "bunx shadcn@4.18.0 build",
    "check-types": "tsc --noEmit",
    "verify:registry": "bunx shadcn@4.18.0 registry validate ./registry.json && bun run build:registry --output .cache/registry-check",
    "verify": "bun run check-types && bun run verify:registry"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "react": "^19.2.6",
    "remotion": "^4.0.470",
    "typescript": "^6.0.2"
  }
}
