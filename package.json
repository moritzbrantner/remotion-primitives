{
  "name": "@moritzbrantner/remotion-primitives",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "build:registry": "bunx shadcn@4.20.1 build",
    "build:showcase": "vite build --config showcase/vite.config.ts",
    "check-types": "tsc --noEmit",
    "dev:showcase": "vite --config showcase/vite.config.ts",
    "dogfood:registry": "bun scripts/dogfood-registry.ts",
    "test:unit": "vitest run",
    "verify:source-contracts": "bun scripts/verify-source-contracts.ts",
    "verify:registry": "bunx shadcn@4.20.1 registry validate ./registry.json && bun run build:registry --output .cache/registry-check",
    "verify": "bun run check-types && bun run test:unit && bun run verify:source-contracts && bun run verify:registry && bun run build:showcase"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@remotion/captions": "4.0.537",
    "@remotion/player": "4.0.537",
    "@types/bun": "1.4.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.537",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "4.1.12"
  }
}
